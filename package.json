{
  "name": "legion-dice-sim",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "highcharts": "^12.1.0",
    "highcharts-react-official": "^3.2.0",
    "jquery": "^3.7.0",
    "mathjs": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "web-vitals": "^4.2.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "jest --maxWorkers=3 --colors --coverage",
    "test-us": "jest -u --maxWorkers=3 --colors --coverage",
    "testWatch": "jest --watch",
    "scss": "sass --watch src/scss:src/css",
    "lint": "eslint src/**/*.{js,ts,tsx} --quiet",
    "lint-all": "eslint src/**/*.{js,ts,tsx}",
    "lint-fix": "eslint src/**/*.{js,ts,tsx} --quiet --fix",
    "format:check": "prettier --check src/**/*.{ts,tsx,json,scss,css}",
    "format:fix": "prettier --write src/**/*.{ts,tsx,json,scss,css}",
    "cloc": "cloc ./src --include-lang='TypeScript,Sass,JSON'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/bootstrap": "^5.2.0",
    "@types/jest": "^29.5.0",
    "@types/jquery": "^3.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ajv": "^8.17.1",
    "eslint": "^10.1.0",
    "husky": "^9.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "sass": "^1.83.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.2",
    "vite": "^6.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,json,scss,css}": [
      "prettier --check"
    ]
  }
}
